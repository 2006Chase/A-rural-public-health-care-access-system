# JeevanSetu Environment Variables Template
DATABASE_URL="file:./prisma/dev.db" # In production: postgresql://user:password@localhost:5432/jeevansetu
JWT_SECRET="replace-with-cryptographically-secure-random-token-in-production"
NEXT_PUBLIC_APP_NAME="JeevanSetu"
NEXT_PUBLIC_APP_TAGLINE="Connecting people to the right care"
NEXT_PUBLIC_DEMO_MODE="true"
NEXT_PUBLIC_DEFAULT_DISTRICT="Maharashtra Demo District"

# External Integrations (Mocked for SIH Prototype)
AI_PROVIDER="mock-rules" # or "gemini" / "openai" / "fastapi"
AI_API_KEY=""
MAPS_PROVIDER="mock-geo" # or "google-maps"
MAPS_API_KEY=""
FHIR_BASE_URL="http://localhost:3000/api/fhir"
ABDM_MOCK_ENABLED="true"
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""

# Storage
STORAGE_PROVIDER="local" # or "gcs" / "s3"
STORAGE_LOCAL_PATH="./uploads"
STORAGE_BUCKET_NAME=""

PORT=3000
