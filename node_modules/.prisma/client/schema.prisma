// JeevanSetu Prisma Schema
// Optimized for SQLite (Local/Demo) & 100% compatible with PostgreSQL (Production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  phone        String   @unique
  name         String
  role         String // PATIENT, HEALTH_WORKER, DOCTOR, FACILITY_ADMIN, SYSTEM_ADMIN
  passwordHash String
  facilityId   String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile      Patient?
  practitionerProfile Practitioner?

  @@index([role])
  @@index([facilityId])
}

model Patient {
  id                String   @id @default(uuid())
  userId            String?  @unique
  nationalHealthId  String   @unique // ABHA format: 91-XXXX-XXXX-XXXX
  fullName          String
  dateOfBirth       String
  gender            String // MALE, FEMALE, OTHER
  phone             String
  emergencyPhone    String?
  bloodGroup        String?
  address           String
  village           String
  district          String
  state             String   @default("Maharashtra")
  pinCode           String
  preferredLanguage String   @default("mr") // en, hi, mr
  assignedWorkerId  String?
  allergies         String? // JSON or comma-separated
  chronicConditions String? // JSON or comma-separated
  riskLevel         String   @default("ROUTINE") // ROUTINE, MEDIUM, HIGH
  riskReason        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user             User?             @relation(fields: [userId], references: [id])
  appointments     Appointment[]
  encounters       Encounter[]
  prescriptions    Prescription[]
  diagnosticOrders DiagnosticOrder[]
  referrals        Referral[]
  followUps        FollowUp[]
  documents        Document[]
  consents         Consent[]
  observations     Observation[]
  conditions       Condition[]
  queueEntries     QueueEntry[]

  @@index([nationalHealthId])
  @@index([phone])
  @@index([district])
  @@index([riskLevel])
  @@index([assignedWorkerId])
}

model Practitioner {
  id                String   @id @default(uuid())
  userId            String   @unique
  fullName          String
  licenseNumber     String   @unique
  qualification     String
  specialty         String // General Medicine, Orthopedics, Pediatrics, Gynecology, Cardiology, Surgery
  department        String
  facilityId        String
  isAvailable       Boolean  @default(true)
  teleconsultActive Boolean  @default(true)
  consultationFee   Float    @default(0)
  languagesSpoken   String   @default("en,hi,mr")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  facility         Facility          @relation(fields: [facilityId], references: [id])
  appointments     Appointment[]
  encounters       Encounter[]
  prescriptions    Prescription[]
  diagnosticOrders DiagnosticOrder[]
  referralsMade    Referral[]

  @@index([facilityId])
  @@index([specialty])
}

model Facility {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique
  type           String // SUB_CENTRE, PHC, RURAL_HOSPITAL, SUB_DISTRICT_HOSPITAL, DISTRICT_HOSPITAL, PRIVATE_HOSPITAL, DIAGNOSTIC_CENTRE
  ownership      String // GOVERNMENT, PRIVATE
  address        String
  district       String
  state          String   @default("Maharashtra")
  pinCode        String
  latitude       Float
  longitude      Float
  phone          String
  emergencyPhone String
  hasEmergency   Boolean  @default(false)
  hasTeleconsult Boolean  @default(false)
  hasDiagnostics Boolean  @default(false)
  hasPharmacy    Boolean  @default(true)
  operatingHours String   @default("24x7 Emergency, 09:00 - 17:00 OPD")
  bedCount       Int      @default(10)
  lastUpdated    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  practitioners    Practitioner[]
  departments      Department[]
  appointments     Appointment[]
  queues           Queue[]
  inventory        FacilityInventory[]
  referralsFrom    Referral[]          @relation("ReferringFacility")
  referralsTo      Referral[]          @relation("ReceivingFacility")
  encounters       Encounter[]
  prescriptions    Prescription[]
  diagnosticOrders DiagnosticOrder[]
  followUps        FollowUp[]

  @@index([district])
  @@index([type])
  @@index([ownership])
}

model Department {
  id          String   @id @default(uuid())
  facilityId  String
  name        String
  headDoctor  String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id])
  queues   Queue[]

  @@index([facilityId])
}

model Appointment {
  id                   String   @id @default(uuid())
  appointmentNumber    String   @unique
  patientId            String
  practitionerId       String?
  facilityId           String
  departmentId         String?
  date                 String // YYYY-MM-DD
  timeSlot             String // e.g. "10:00 - 10:30"
  type                 String   @default("IN_PERSON") // IN_PERSON, TELECONSULT
  status               String   @default("CONFIRMED") // REQUESTED, CONFIRMED, CHECKED_IN, IN_QUEUE, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW, RESCHEDULED
  reason               String
  queueToken           String?
  estimatedWaitMinutes Int?     @default(15)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id])
  practitioner Practitioner? @relation(fields: [practitionerId], references: [id])
  facility     Facility      @relation(fields: [facilityId], references: [id])
  encounter    Encounter?
  queueEntry   QueueEntry?

  @@index([patientId])
  @@index([facilityId])
  @@index([date])
  @@index([status])
}

model Queue {
  id                  String   @id @default(uuid())
  facilityId          String
  departmentId        String?
  date                String // YYYY-MM-DD
  status              String   @default("ACTIVE") // ACTIVE, PAUSED, CLOSED
  totalTokens         Int      @default(0)
  currentServingToken Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  facility   Facility     @relation(fields: [facilityId], references: [id])
  department Department?  @relation(fields: [departmentId], references: [id])
  entries    QueueEntry[]

  @@index([facilityId, date])
}

model QueueEntry {
  id                   String    @id @default(uuid())
  queueId              String
  appointmentId        String?   @unique
  patientId            String
  tokenNumber          Int
  tokenDisplay         String // e.g. "OPD-014"
  priority             String    @default("ROUTINE") // EMERGENCY, URGENT, HIGH, ROUTINE
  status               String    @default("WAITING") // WAITING, CALLED, IN_SERVICE, COMPLETED, SKIPPED, CANCELLED
  checkInTime          DateTime  @default(now())
  estimatedWaitMinutes Int       @default(20)
  calledTime           DateTime?
  serviceStartTime     DateTime?
  serviceEndTime       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  queue       Queue        @relation(fields: [queueId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([queueId, status])
  @@index([patientId])
}

model Encounter {
  id              String    @id @default(uuid())
  encounterNumber String    @unique
  patientId       String
  practitionerId  String
  facilityId      String
  appointmentId   String?   @unique
  type            String    @default("OUTPATIENT") // OUTPATIENT, EMERGENCY, TELECONSULT, INPATIENT
  status          String    @default("FINISHED") // PLANNED, IN_PROGRESS, FINISHED, CANCELLED
  chiefComplaint  String
  symptoms        String?
  vitalsSummary   String?
  assessment      String
  clinicalNotes   String?
  plan            String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  patient          Patient           @relation(fields: [patientId], references: [id])
  practitioner     Practitioner      @relation(fields: [practitionerId], references: [id])
  facility         Facility          @relation(fields: [facilityId], references: [id])
  appointment      Appointment?      @relation(fields: [appointmentId], references: [id])
  prescriptions    Prescription[]
  diagnosticOrders DiagnosticOrder[]
  referrals        Referral[]
  followUps        FollowUp[]
  observations     Observation[]
  conditions       Condition[]
  documents        Document[]

  @@index([patientId])
  @@index([practitionerId])
  @@index([facilityId])
}

model Observation {
  id             String   @id @default(uuid())
  patientId      String
  encounterId    String?
  category       String // VITAL_SIGNS, LAB_RESULT, SYMPTOM
  code           String // SYSTOLIC_BP, DIASTOLIC_BP, HEART_RATE, TEMPERATURE, SPO2, RESPIRATORY_RATE, BLOOD_GLUCOSE, WEIGHT, HEIGHT, BMI
  name           String // Blood Pressure, Heart Rate, etc.
  value          String
  unit           String
  interpretation String   @default("NORMAL") // NORMAL, HIGH, LOW, CRITICAL
  recordedAt     DateTime @default(now())
  recordedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])

  @@index([patientId])
  @@index([code])
}

model Condition {
  id                 String   @id @default(uuid())
  patientId          String
  encounterId        String?
  code               String // ICD-10 or clinical concept
  title              String
  clinicalStatus     String   @default("ACTIVE") // ACTIVE, RECURRENCE, RELAPSE, INACTIVE, REMISSION, RESOLVED
  verificationStatus String   @default("CONFIRMED") // PROVISIONAL, DIFFERENTIAL, CONFIRMED, REFUTED
  category           String   @default("CHRONIC") // CHRONIC, ACUTE, MATERNAL
  severity           String   @default("MODERATE") // MILD, MODERATE, SEVERE
  onsetDate          String?
  recordedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])

  @@index([patientId])
  @@index([clinicalStatus])
}

model Prescription {
  id                 String   @id @default(uuid())
  prescriptionNumber String   @unique
  encounterId        String
  patientId          String
  practitionerId     String
  facilityId         String
  status             String   @default("SIGNED") // DRAFT, SIGNED, ACTIVE, COMPLETED, CANCELLED, EXPIRED
  diagnosisSummary   String
  instructions       String?
  qrReferenceToken   String   @unique // Opaque signed reference (NO raw PHI)
  qrTokenSignature   String
  qrExpiresAt        DateTime
  signedAt           DateTime @default(now())
  signedBy           String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  encounter    Encounter          @relation(fields: [encounterId], references: [id])
  patient      Patient            @relation(fields: [patientId], references: [id])
  practitioner Practitioner       @relation(fields: [practitionerId], references: [id])
  facility     Facility           @relation(fields: [facilityId], references: [id])
  items        PrescriptionItem[]

  @@index([patientId])
  @@index([practitionerId])
  @@index([qrReferenceToken])
}

model PrescriptionItem {
  id                    String   @id @default(uuid())
  prescriptionId        String
  medicineName          String
  genericName           String?
  dosage                String // e.g. "500 mg"
  form                  String // TABLET, SYRUP, INJECTION, CAPSULE, OINTMENT
  route                 String   @default("ORAL") // ORAL, TOPICAL, INTRAVENOUS, INTRAMUSCULAR
  frequency             String // OD (once daily), BD (twice daily), TID (thrice daily), SOS (as needed)
  durationDays          Int      @default(5)
  instructions          String? // e.g. "After food with warm water"
  quantity              Int      @default(10)
  isAvailableInFacility Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([prescriptionId])
}

model DiagnosticOrder {
  id                String    @id @default(uuid())
  orderNumber       String    @unique
  encounterId       String?
  patientId         String
  practitionerId    String
  facilityId        String
  testName          String // X-Ray Knee AP/Lateral, Complete Blood Count, Blood Glucose, HbA1c, Urine Routine
  testCategory      String // RADIOLOGY, HEMATOLOGY, BIOCHEMISTRY, PATHOLOGY, MICROBIOLOGY
  priority          String    @default("ROUTINE") // ROUTINE, URGENT, EMERGENCY
  status            String    @default("ORDERED") // ORDERED, SCHEDULED, SAMPLE_COLLECTED, PROCESSING, RESULT_READY, REVIEWED, CANCELLED
  instructions      String?
  orderedAt         DateTime  @default(now())
  sampleCollectedAt DateTime?
  resultReadyAt     DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  resultSummary     String?
  resultDetailsJson String? // Structured values
  abnormalFlag      Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  encounter    Encounter?   @relation(fields: [encounterId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  practitioner Practitioner @relation(fields: [practitionerId], references: [id])
  facility     Facility     @relation(fields: [facilityId], references: [id])

  @@index([patientId])
  @@index([facilityId])
  @@index([status])
}

model Referral {
  id                      String    @id @default(uuid())
  referralNumber          String    @unique
  encounterId             String?
  patientId               String
  referringPractitionerId String
  referringFacilityId     String
  receivingFacilityId     String
  requestedSpecialty      String // Orthopedics, Cardiology, General Surgery, Gynecology
  priority                String    @default("ROUTINE") // ROUTINE, URGENT, EMERGENCY
  reason                  String
  clinicalSummary         String
  status                  String    @default("CREATED") // CREATED, ACCEPTED, SCHEDULED, PATIENT_ARRIVED, IN_PROGRESS, COMPLETED, OVERDUE, CANCELLED
  patientAcknowledged     Boolean   @default(false)
  dueDate                 String // YYYY-MM-DD
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  encounter             Encounter?   @relation(fields: [encounterId], references: [id])
  patient               Patient      @relation(fields: [patientId], references: [id])
  referringPractitioner Practitioner @relation(fields: [referringPractitionerId], references: [id])
  referringFacility     Facility     @relation("ReferringFacility", fields: [referringFacilityId], references: [id])
  receivingFacility     Facility     @relation("ReceivingFacility", fields: [receivingFacilityId], references: [id])

  @@index([patientId])
  @@index([receivingFacilityId])
  @@index([status])
}

model FollowUp {
  id                  String   @id @default(uuid())
  encounterId         String?
  patientId           String
  practitionerId      String?
  facilityId          String
  scheduledDate       String // YYYY-MM-DD
  reason              String
  status              String   @default("PENDING") // PENDING, COMPLETED, MISSED, RESCHEDULED
  priority            String   @default("ROUTINE") // ROUTINE, MEDIUM, HIGH
  isHighRiskEscalated Boolean  @default(false)
  assignedWorkerId    String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  encounter Encounter? @relation(fields: [encounterId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  facility  Facility   @relation(fields: [facilityId], references: [id])

  @@index([patientId])
  @@index([scheduledDate])
  @@index([status])
  @@index([assignedWorkerId])
}

model Medicine {
  id           String   @id @default(uuid())
  name         String   @unique
  genericName  String
  category     String // Analgesic, Antibiotic, Antihypertensive, Antidiabetic, Antacid, Vitamin
  form         String // Tablet, Syrup, Injection, Capsule, Ointment
  strength     String // 500mg, 10mg, etc.
  isEssential  Boolean  @default(true)
  standardUnit String   @default("strips")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventories FacilityInventory[]

  @@index([genericName])
  @@index([category])
}

model FacilityInventory {
  id                String   @id @default(uuid())
  facilityId        String
  medicineId        String
  quantityInStock   Int      @default(0)
  batchNumber       String   @default("BATCH-2026-A")
  expiryDate        String   @default("2027-12-31")
  lowStockThreshold Int      @default(50)
  isAvailable       Boolean  @default(true)
  lastUpdated       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id])
  medicine Medicine @relation(fields: [medicineId], references: [id])

  @@unique([facilityId, medicineId])
  @@index([facilityId])
  @@index([medicineId])
  @@index([isAvailable])
}

model Document {
  id                 String    @id @default(uuid())
  patientId          String
  encounterId        String?
  title              String
  type               String // PAPER_PRESCRIPTION, LAB_REPORT, RADIOLOGY_IMAGE, DISCHARGE_SUMMARY
  fileUrl            String
  mimeType           String    @default("image/jpeg")
  fileSize           Int       @default(102400)
  extractedDataJson  String? // Extracted medicines, dosages, instructions with confidence
  ocrConfidenceScore Float?    @default(0.85)
  verificationStatus String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, VERIFIED, REJECTED
  verifiedById       String?
  verifiedAt         DateTime?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])

  @@index([patientId])
  @@index([verificationStatus])
}

model Consent {
  id             String    @id @default(uuid())
  patientId      String
  purpose        String // "Care Continuity", "Teleconsultation", "Diagnostic Sharing"
  dataCategory   String // "Prescriptions, Diagnoses, Vitals"
  recipientScope String // "District Hospital Doctors, Assigned ASHA Worker"
  status         String    @default("GRANTED") // GRANTED, REVOKED, EXPIRED
  grantedAt      DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([status])
}

model AuditEvent {
  id           String   @id @default(uuid())
  actorId      String
  actorRole    String
  action       String // RECORD_VIEWED, PRESCRIPTION_SIGNED, REFERRAL_CREATED, QR_SCANNED, CONSENT_GRANTED
  resource     String // Patient, Prescription, Referral, Document
  resourceId   String
  facilityId   String?
  ipAddress    String?  @default("127.0.0.1")
  userAgent    String?
  outcome      String   @default("SUCCESS") // SUCCESS, FAILURE
  metadataJson String?
  timestamp    DateTime @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([timestamp])
}

model GovernmentService {
  id             String   @id @default(uuid())
  title          String
  category       String // MATERNAL_CHILD, FINANCIAL_PROTECTION, MENTAL_HEALTH, IMMUNIZATION, CHRONIC_DISEASE
  targetGroup    String
  description    String
  eligibility    String
  benefits       String
  howToAccess    String
  officialSource String
  officialUrl    String?
  helplineNumber String?
  language       String   @default("en")
  isActive       Boolean  @default(true)
  lastUpdated    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model SyncOperation {
  id           String   @id @default(uuid())
  deviceId     String
  userId       String
  entityType   String // Vitals, Observation, Appointment, Document
  entityId     String
  operation    String // CREATE, UPDATE, DELETE
  payloadJson  String
  version      Int      @default(1)
  status       String   @default("PENDING") // PENDING, SYNCING, SYNCED, FAILED, CONFLICT
  retryCount   Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, status])
  @@index([deviceId])
}
